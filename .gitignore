# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Secrets - NEVER commit this file (contains your OpenRouter API key if enabled)
.env

# Node
node_modules/
frontend/dist/

# Built frontend (regenerate via: cd frontend && npm install --include=dev && npm run build)
backend/app/static/

# Database (regenerated on first run)
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm

# Runtime data (user files, caches, auto-downloaded models)
data/uploads/
data/reports/
data/hf-cache/
data/models/ecapa-tdnn/
data/datasets/*.csv
data/datasets/*.jsonl

# ML model weights - generated by backend/ml/train_*.py. Ignore by default,
# then ship the small pre-trained ones so the app works right after cloning.
data/models/*.joblib
data/models/*.pt
data/models/*.pth
data/models/*.bin
data/models/*.onnx
data/models/whisper-*/

!data/models/scam_classifier.joblib
!data/models/aasist.pth
!data/models/mesonet/

# Wav2Vec2 ASVspoof ensemble weights (~1.6 GB) - auto-downloaded from
# Hugging Face on first run when the local folder is missing.
data/models/wav2vec2-deepfake/
data/models/wav2vec2-large-vcd/

# Runtime
*.log
.DS_Store
Thumbs.db

# PyInstaller build output & archives
build/
dist/
*.exe
*.zip

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
