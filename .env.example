# DigiRaksha Configuration Template
# Rename this file to .env before starting the server

# Optional LLM Second-Opinion Copilot (via OpenRouter)
ENABLE_LLM_ANALYSIS=false
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=poolside/laguna-s-2.1:free
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3.5-lightning:free,z-ai/glm-5.2:free,minimax/minimax-m3:free,poolside/laguna-xs-2.1:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Security & Session Authentication
SECRET_KEY=generate_a_random_32_character_secret_key_here
# Default PIN hash (PIN: 1234) or create on first launch in the UI
PIN_HASH=
